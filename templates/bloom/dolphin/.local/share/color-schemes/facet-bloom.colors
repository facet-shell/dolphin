# facet bloom ({{name}}) for KDE apps (Dolphin). Generated by facet theme from themes/<theme>.json,
# edit templates/bloom/dolphin/.local/share/color-schemes/facet-bloom.colors instead.
# Window and Header are the darkest tone (bloom's gaps), View the panels (file view, places),
# Selection the picked-item pill (secondary container with plain text).

[ColorEffects:Disabled]
Color={{tones.surface|rgb}}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{tones.surface|rgb}}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate={{tones.high|rgb}}
BackgroundNormal={{tones.container|rgb}}
DecorationFocus={{tones.primary|rgb}}
DecorationHover={{tones.primary|rgb}}
ForegroundActive={{tones.primary|rgb}}
ForegroundInactive={{tones.dim|rgb}}
ForegroundLink={{tones.primary|rgb}}
ForegroundNegative={{tones.error|rgb}}
ForegroundNeutral={{colors.warn|rgb}}
ForegroundNormal={{tones.text|rgb}}
ForegroundPositive={{tones.ok|rgb}}
ForegroundVisited={{tones.tertiary|rgb}}

[Colors:Complementary]
BackgroundAlternate={{tones.container|rgb}}
BackgroundNormal={{tones.page|rgb}}
DecorationFocus={{tones.primary|rgb}}
DecorationHover={{tones.primary|rgb}}
ForegroundActive={{tones.primary|rgb}}
ForegroundInactive={{tones.dim|rgb}}
ForegroundLink={{tones.primary|rgb}}
ForegroundNegative={{tones.error|rgb}}
ForegroundNeutral={{colors.warn|rgb}}
ForegroundNormal={{tones.text|rgb}}
ForegroundPositive={{tones.ok|rgb}}
ForegroundVisited={{tones.tertiary|rgb}}

[Colors:Header]
BackgroundAlternate={{tones.page|rgb}}
BackgroundNormal={{tones.page|rgb}}
DecorationFocus={{tones.primary|rgb}}
DecorationHover={{tones.primary|rgb}}
ForegroundActive={{tones.primary|rgb}}
ForegroundInactive={{tones.dim|rgb}}
ForegroundLink={{tones.primary|rgb}}
ForegroundNegative={{tones.error|rgb}}
ForegroundNeutral={{colors.warn|rgb}}
ForegroundNormal={{tones.text|rgb}}
ForegroundPositive={{tones.ok|rgb}}
ForegroundVisited={{tones.tertiary|rgb}}

[Colors:Header][Inactive]
BackgroundAlternate={{tones.page|rgb}}
BackgroundNormal={{tones.page|rgb}}
DecorationFocus={{tones.primary|rgb}}
DecorationHover={{tones.primary|rgb}}
ForegroundActive={{tones.primary|rgb}}
ForegroundInactive={{tones.dim|rgb}}
ForegroundLink={{tones.primary|rgb}}
ForegroundNegative={{tones.error|rgb}}
ForegroundNeutral={{colors.warn|rgb}}
ForegroundNormal={{tones.dim|rgb}}
ForegroundPositive={{tones.ok|rgb}}
ForegroundVisited={{tones.tertiary|rgb}}

[Colors:Selection]
BackgroundAlternate={{tones.primaryContainer|rgb}}
BackgroundNormal={{tones.secondaryContainer|rgb}}
DecorationFocus={{tones.primary|rgb}}
DecorationHover={{tones.primary|rgb}}
ForegroundActive={{tones.text|rgb}}
ForegroundInactive={{tones.dim|rgb}}
ForegroundLink={{tones.primary|rgb}}
ForegroundNegative={{tones.error|rgb}}
ForegroundNeutral={{colors.warn|rgb}}
ForegroundNormal={{tones.text|rgb}}
ForegroundPositive={{tones.ok|rgb}}
ForegroundVisited={{tones.tertiary|rgb}}

[Colors:Tooltip]
BackgroundAlternate={{tones.high|rgb}}
