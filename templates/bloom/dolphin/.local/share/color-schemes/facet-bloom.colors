[General]
ColorScheme=facet-bloom
Name=facet bloom
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground={{tones.page|rgb}}
activeBlend={{tones.primary|rgb}}
activeForeground={{tones.text|rgb}}
inactiveBackground={{tones.page|rgb}}
inactiveBlend={{tones.outline|rgb}}
inactiveForeground={{tones.dim|rgb}}
