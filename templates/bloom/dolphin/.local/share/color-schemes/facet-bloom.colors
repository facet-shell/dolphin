[Colors:Window]
BackgroundAlternate={{tones.surface|rgb}}
BackgroundNormal={{tones.page|rgb}}
DecorationFocus={{tones.primary|rgb}}
DecorationHover={{tones.primary|rgb}}
ForegroundActive={{tones.primary|rgb}}
